# QA Agent Pro — configuration (.env)
# Read at server startup; restart your MCP client after editing.

# --- LLM backend ------------------------------------------------------
# auto   = match the host editor: Cursor -> cursor-agent, Claude -> claude CLI
# cli    = claude CLI OAuth session (run `claude login` once; no API key)
# api    = Anthropic API (set ANTHROPIC_API_KEY)
# cursor = cursor-agent subprocess (CURSOR_API_KEY or cursor-agent login)
QA_LLM_BACKEND=auto
QA_LLM_TIMEOUT_S=300               # per-LLM-call timeout (seconds)
# ANTHROPIC_API_KEY=sk-ant-...
# CURSOR_API_KEY=...

# --- Features -----------------------------------------------------------
QA_SWAGGER_ENABLED=true          # Swagger/OpenAPI link -> API test cases
QA_FEATURE_ANALYSIS_ENABLED=true # qa_feature_analysis tool (Jira / mobile / both)
QA_MOBILE_CAPTURE=true           # device screens -> test cases (vision needs ANTHROPIC_API_KEY)
QA_RAG_ENABLED=true              # learn from past suites: grounding, duplicate flags, qa_search_corpus
QA_RAG_SIMILARITY_MODE=bm25     # BM25 ranking — best-practice lexical retrieval
QA_RAG_RECENCY_HALF_LIFE_DAYS=30 # fresh suites rank slightly higher
QA_RAG_MAX_ENTRIES=5000         # corpus cap — oldest entries pruned beyond this
QA_MCP_ELICIT_ENABLED=true       # interactive pickers (Cursor 1.5+, Claude Code); text-menu fallback elsewhere
QA_AUTO_EXPORT_XLSX=1            # auto-build the Excel file when generation finishes; the reply shows its path
QA_EXPORT_DIR=data/exports       # save auto-exported .xlsx here (relative to the install dir; files persist across sessions/updates)

# --- Updates & integrity ------------------------------------------------
# Releases are Ed25519-signed (MANIFEST.sig); verification is automatic.
# During migration an unsigned release still installs with a warning.
# Flip on once every live release is signed to REFUSE unsigned updates:
# QA_UPDATE_REQUIRE_SIGNATURE=1

# --- Jira (optional: paste ticket URLs once configured) ----------------
# JIRA_BASE_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=...

# --- Usage analytics (telemetry) ---------------------------------------
# Anonymous usage metrics (tool name, version, OS, timings, success).
# ON by default; see the README 'Telemetry & privacy' section. Opt out
# with EITHER of the following:
# QA_TELEMETRY_DISABLED=1
# DO_NOT_TRACK=1
# Optionally identify this install (known teams only - sets person email):
# QA_USER_EMAIL=you@company.com
