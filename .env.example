# QA Agent Pro — configuration (.env)
# Read at server startup; restart your MCP client after editing.

# --- LLM credentials: NONE REQUIRED -------------------------------------
# This edition generates test cases in YOUR OWN chat model -- the editor
# you connected it to. The server never calls an LLM API of its own, so
# there is no API key and no CLI login to configure. QA_LLM_BACKEND,
# ANTHROPIC_API_KEY and CURSOR_API_KEY are deliberately absent from this
# file. qa-doctor still PROBES for a backend and reports what it
# happens to find, but a missing one is not a problem on this edition.

# --- Features -----------------------------------------------------------
# Swagger/OpenAPI link -> API test cases.
QA_SWAGGER_ENABLED=true
# QA_FEATURE_ANALYSIS_ENABLED is deliberately NOT shipped (code default
# OFF), and setting it by hand does NOTHING here: since 2026-08-03 this
# edition does not register qa_feature_analysis /
# qa_submit_feature_analysis at all. Their mobile modes described
# captured screens with this server's OWN vision call -- the last
# tester-facing path that needed a credential.
# Device screens -> test cases. The screenshots ride to YOUR chat model
# as MCP image content; no server-side vision call, no API key. This
# also makes qa_capture_screens LIVE by default on this edition, which
# is deliberate: it is how a tester grounds a Jira ticket's cases in the
# real screens, since Jira returns attachment metadata but never bytes.
QA_MOBILE_CAPTURE=true
# Learn from past suites: grounding, duplicate flags, qa_search_corpus.
QA_RAG_ENABLED=true
# 2026-08-01: bm25 -> cosine. BM25's IDF weighting COLLAPSES TOWARD ZERO
# for terms that come to dominate the corpus -- and any tester's corpus
# accumulates exactly that over time (repeated tickets, recurring
# features). Verified directly: on a 1524-entry corpus dominated by one
# repeated feature, the query with the MOST real matching history
# scored LOWEST (0.052) while an unrelated query scored HIGHEST (0.524)
# -- an INVERTED ranking, not a miscalibrated threshold. TF-IDF cosine
# does not have this pathology and ranked the same corpus correctly
# (0.702 for the real match vs 0.291 for the unrelated control).
QA_RAG_SIMILARITY_MODE=cosine
# Fresh suites rank slightly higher.
QA_RAG_RECENCY_HALF_LIFE_DAYS=30
# Corpus cap — oldest entries pruned beyond this.
QA_RAG_MAX_ENTRIES=5000
# Relevance floor for the 'Similar Past Test Cases' block injected into
# the prompt. Recalibrated for cosine's empirically observed range on a
# real corpus (~0.2-0.3 for an unrelated query, ~0.6-0.7 for a genuine
# topical match). The scale is MODE-dependent, so this value belongs
# with QA_RAG_SIMILARITY_MODE=cosine above; 0 disables it.
QA_RAG_SIMILAR_MIN_SCORE=0.4
# Duplicate-risk block's own threshold. The code default (0.3) was
# itself bm25-calibrated (see config/settings.py) and sits INSIDE
# cosine's observed 'unrelated' range (~0.29), which would false-flag
# unrelated cases as duplicates under cosine -- shipped explicitly
# above that range.
QA_RAG_SIMILARITY_THRESHOLD=0.55
# Per-case data-provisioning plan -> fills the Excel 'Test Data' column.
# Without it 52 of 65 Test Data cells came back empty on a real run.
QA_TEST_DATA_STRATEGY=true
# Write the computed risk SCORE into the Excel Notes column when no
# rule-pack note claims it (that column was empty in 65/65 rows). The risk
# LABEL was dropped 2026-08-04: it duplicated the Priority column.
QA_XLSX_RISK_NOTES=true
# Cache the 'is this ticket detailed enough?' verdict per ticket content,
# in seconds (0 = off). MEASURED 55.8s for that one check on a real run; a
# repeat request for the same ticket used to pay it again in full. This
# check runs on EVERY generation, not only host mode, so the value is
# deliberately short: long enough to cover a retry inside one session,
# short enough that an edited ticket is judged again. A ticket that could
# NOT be classified is never cached, so the safety gate still fires.
QA_AMBIGUITY_CACHE_TTL_S=300
# Type the 8 'Edge Cases' as Functional rather than Exploratory. They are
# fully scripted, and typing them Exploratory skewed the Summary sheet's
# test-type metrics.
QA_EDGE_CASES_FUNCTIONAL_TYPE=true
# Merge a product-qualified module label onto the bare one it qualifies.
# The 8 categories are generated in parallel, blind to each other, and
# `module` is free text -- so one feature can ship as 'Cancel Order' (86
# cases) AND 'Sehhaty Store - Cancel Order' (12), splitting every group-by
# module view. Merges only when the bare label is the TRAILING part of the
# qualified one; 'Store Wallet - Top Up' is a SUB-MODULE of 'Store Wallet'
# and is deliberately left alone. OFF by default: a wrong merge silently
# destroys a real distinction, which is worse than the split it fixes.
QA_MODULE_PREFIX_NORMALIZE_ENABLED=true
# Re-register this server in your editors' MCP configs on startup. The
# installer already did this once; this only helps when you install
# ANOTHER editor later, which would otherwise never be picked up.
# OFF by default because it writes outside the install dir. It only ever
# ADDS a missing entry -- an entry you edited yourself is never touched --
# and the write is atomic and locked. If no editor is registered at all,
# run ~/qa-agent-pro/connect.sh: nothing starts the server, so a startup
# pass cannot bootstrap your first client.
QA_AUTO_REGISTER_CLIENTS=false
# Let connect.sh / connect.ps1 add the Atlassian (Jira Cloud) MCP entry
# to your editor, instead of you hand-editing mcpServers JSON. ON by
# default: it runs only when YOU run connect, only ADDS a missing entry
# -- an existing `atlassian` entry is never touched -- and the write is
# atomic, locked and backed up. It does NOT log you in: OAuth is still
# one click in the editor. Claude Desktop is unaffected, because its
# Atlassian Connector lives in claude.ai settings and not in a file.
# qa-doctor also writes it when missing, because an install that
# auto-updated never re-runs connect and would otherwise never get it.
# Set false to have both print the JSON for you to add by hand.
QA_REGISTER_ATLASSIAN_MCP=true
# Interactive pickers (Cursor 1.5+, Claude Code); text-menu fallback elsewhere.
QA_MCP_ELICIT_ENABLED=true
# Auto-build the Excel file when generation finishes; the reply shows its path.
QA_AUTO_EXPORT_XLSX=1
# qa-doctor repairs settings in THIS file whose value is still
# exactly a default an older version shipped and a later one superseded
# -- so an update actually reaches your config instead of stopping at
# new keys only. A value YOU chose is never touched, a commented-out key
# counts as a deliberate opt-out, and this file is backed up first.
# Every change is listed in the qa-doctor report.
QA_ENV_SELFHEAL_ENABLED=true
# Folder for auto-exported .xlsx files, relative to the install dir.
# Files persist here across sessions and updates. Keep the comment on its
# OWN line: a value with a trailing comment reads fine to python-dotenv,
# but it has been echoed back verbatim when a host was asked where to save.
QA_EXPORT_DIR=data/exports
# Verify Jira access before generating from a ticket URL; guides token setup.
QA_JIRA_PREFLIGHT=true
# Sub-task tickets: pull the parent story in as background context.
JIRA_FETCH_PARENT=true
# Cap on that background block, so a big epic cannot crowd out the sub-task.
JIRA_MAX_PARENT_CHARS=2500
# Sibling USER STORIES under the same parent, WITH their descriptions and
# acceptance criteria -- not just their titles. A sub-task carries a
# one-line summary while the requirements live in the parent AND in the
# stories beside it. Adds ONE search call to the fetch, and only when the
# ticket has a parent. The text goes into the clearly-labelled BACKGROUND
# block (never as the thing under test, every URL stripped).
JIRA_FETCH_SIBLING_STORIES=true
# Characters the sibling block may use, ADDITIVE to JIRA_MAX_PARENT_CHARS
# so sibling text can never truncate the parent's own description.
JIRA_MAX_SIBLING_CHARS=3000
# Extract acceptance criteria from a USE-CASE TABLE description. The AC
# fallback only understands an 'Acceptance Criteria' heading; a whole ticket
# family writes its requirements as a markdown UC table with no such heading
# anywhere (rows labelled Basic Flow / Alternative Flow / Business Rules /
# Post-condition), so extraction found nothing and the suite finalized with
# ZERO criteria and no traceability. ON, each requirement-bearing row becomes
# one criterion. OFF by default because it adds ticket text to the prompt.
QA_JIRA_UC_TABLE_AC_ENABLED=true
# Search the other Jira custom fields for one whose VALUE reads like
# requirements when JIRA_AC_FIELD does not. OFF: adopting the wrong field is
# the failure this guards against -- the default field id is a DATE field on
# at least one real workspace, and its timestamp became a suite's only
# acceptance criterion. qa-doctor prints the configured field either way.
QA_JIRA_AC_FIELD_DISCOVERY=false
# Deterministic advisories on the finalize summary: option values the ticket
# never defines, requirements no case mentions, defects in the ticket itself
# (duplicate rule/table ids, one label on two controls), expected results that
# accept two opposite outcomes, and cases that disagree about whether a seeded
# status permits an action. ON -- they run no model, change no case, and print
# nothing when they find nothing. Set false to silence them.
QA_GROUNDING_ADVISORIES_ENABLED=true
# Ask your own chat model to judge whether each generated case's expected
# result actually follows from the ticket. This is the one judgement the
# checks above cannot make -- they are all lexical, so a fluent invention
# ('a refund status appears') passes every one of them. Cases judged
# unsupported move to an 'Assumed Requirements' sheet in the export instead of
# the executable suite; nothing is ever deleted. OFF by default: it changes
# what your model is asked to do and costs one judgement per case.
QA_HOST_GROUNDING_REVIEW_ENABLED=false
# Ticket comments. Costs nothing extra: comments come back in the SAME
# getJiraIssue call your Atlassian MCP connection already makes. A ticket
# description is a snapshot taken at refinement, while the requirements
# that are actually current accumulate in the comment thread.
JIRA_FETCH_COMMENTS=true
JIRA_MAX_COMMENTS=5
# Image attachments. This does NOT give the model vision: your Atlassian
# MCP connection returns attachment metadata (name/type/size), never the
# image bytes. What you get is the filenames as context, plus a notice
# naming them and asking you to drag those screenshots into the chat --
# where they ARE read. Without it, a suite was generated from ticket text
# that never saw the screenshots and nothing said so.
JIRA_FETCH_IMAGES=true
# HOST MODE ONLY (QA_GENERATION_MODE=host/auto): ask your own chat model to
# flag cross-category duplicates as it submits. No extra round trip, no API
# key, no server-side LLM call. It only REPORTS -- QA_HOST_DEDUP_APPLY stays
# off, so no case is ever removed. Without it a keyless install collapses
# only byte-identical cases: one real run kept all 64, including two pairs
# identical but for which dialog they used. Set to false to turn the
# section off. Tuning sub-flags (QA_HOST_DEDUP_MAX_GROUPS,
# MAX_GROUP_SIZE, MAX_REMOVAL_RATIO, LOW_TEXT_RATIO) stay at their code
# defaults and only matter once APPLY is turned on.
QA_HOST_DEDUP_REVIEW_ENABLED=true

# HOST MODE: run the SHYJ-7154 ambiguity preflight in the tester's
# own chat instead of the server Claude CLI / API. Avoids
# session-limit CLARIFY false positives (2026-07-30 evening).
# Settings default stays false; template ships true.
QA_HOST_AMBIGUITY_REVIEW_ENABLED=true
# HOST MODE ONLY: steer the parent chat to fan out one same-session worker
# per category (Cursor Task / equivalent). Preferred finalize is Path B
# (merge then qa_submit_suite); Path A uses qa_submit_category +
# qa_prep_status. Inert until QA_GENERATION_MODE=host/auto. Kill-switch:
# QA_HOST_PARALLEL_FANOUT_ENABLED=false.
QA_HOST_PARALLEL_FANOUT_ENABLED=true

# HOST MODE: derive acceptance criteria in the tester's own chat
# instead of calling rtm.generate_acs on this server. That call is
# unconditional for a ticket with no ACs (common for sub-tasks and
# bugs) and is the last generation-related backend call a keyless
# host install cannot avoid. Settings default stays false; the
# template ships true. Kill-switch: QA_HOST_AC_REVIEW_ENABLED=false.
QA_HOST_AC_REVIEW_ENABLED=true

# --- Updates & integrity ------------------------------------------------
# Releases are Ed25519-signed (MANIFEST.sig); verification is automatic.
# During migration an unsigned release still installs with a warning.
# Flip on once every live release is signed to REFUSE unsigned updates:
# QA_UPDATE_REQUIRE_SIGNATURE=1

# --- Jira -----------------------------------------------------------
# Nothing to set here. Paste a ticket URL and the agent reads it through
# your own Atlassian MCP connection (mcp.atlassian.com, OAuth) -- connect
# it once in your client's MCP settings. See docs/FEATURE_FLAGS.md.

# --- Usage analytics (telemetry) ---------------------------------------
# Anonymous usage metrics (tool name, version, OS, timings, success).
# ON by default; see the README 'Telemetry & privacy' section. Opt out
# with EITHER of the following:
# QA_TELEMETRY_DISABLED=1
# DO_NOT_TRACK=1
# Optionally identify this install (known teams only - sets person email):
# QA_USER_EMAIL=you@company.com
