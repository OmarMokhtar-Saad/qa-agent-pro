# QA Agent Pro — configuration (.env)
# Read at server startup; restart your MCP client after editing.

# --- LLM backend ------------------------------------------------------
# cli    = claude CLI OAuth session (run `claude login` once; no API key)
# api    = Anthropic API (set ANTHROPIC_API_KEY)
# cursor = cursor-agent subprocess (CURSOR_API_KEY or cursor-agent login)
QA_LLM_BACKEND=cli
# ANTHROPIC_API_KEY=sk-ant-...
# CURSOR_API_KEY=...

# --- Features -----------------------------------------------------------
QA_SWAGGER_ENABLED=true          # Swagger/OpenAPI link -> API test cases
QA_FEATURE_ANALYSIS_ENABLED=true # qa_feature_analysis tool (Jira / mobile / both)
QA_MOBILE_CAPTURE=true           # device screens -> test cases (vision needs ANTHROPIC_API_KEY)
# QA_RAG_ENABLED=true            # ground generation in past suites + duplicate flagging
# QA_MCP_ELICIT_ENABLED=true     # interactive pickers on clients that support MCP elicitation

# --- Jira (optional: paste ticket URLs once configured) ----------------
# JIRA_BASE_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=...
